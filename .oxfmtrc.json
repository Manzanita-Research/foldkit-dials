{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "printWidth": 80,
  "sortImports": {
    "ignoreCase": false,
    "customGroups": [
      {
        "groupName": "scoped",
        "elementNamePattern": ["@*", "@*/**"]
      }
    ],
    "groups": [
      ["builtin", "external"],
      "scoped",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  },
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/repos/**",
    "**/generated/**",
    "**/*.generated.*",
    "**/.alchemy/**",
    "tooling/scratch/**",
    "**/*.tsbuildinfo",
    "pnpm-lock.yaml",
    "**/.agents/**",
    "**/.claude/**",
    "FOLDKIT.md",
    "CLAUDE.md"
  ]
}
