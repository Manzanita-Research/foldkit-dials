{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "customConditions": ["@pleat/source"],
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "foldkit-dials": ["./packages/foldkit-dials/src/index.ts"],
      "foldkit-dials/*": ["./packages/foldkit-dials/src/*"]
    }
  },
  "include": ["packages/foldkit-dials/src", "demo/src", "demo/vite.config.ts", "vitest.config.ts", "demo/alchemy.run.ts", "stacks", "demo/worker.ts"]
}
